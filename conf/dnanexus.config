// =====================================================================
// DNAnexus profile overrides
// Activate with: -profile dnanexus
// =====================================================================
//
// DNAnexus runs Nextflow via its native "Nextflow Pipeline" applet.
// Each process is mapped to a DNAnexus job. Container images must be
// resolvable from inside the DNAnexus worker (Docker Hub / GHCR / DX
// project file).
//
// To pin containers to a private DNAnexus image, override in deploy:
//   process.container = 'dx://project-xxxx:/containers/trust4.tar.gz'
// ---------------------------------------------------------------------

profiles {
    dnanexus {
        process {
            executor = 'local'   // dx-nextflow wraps each task as a dx job
            withLabel: 'process_low'    { machineType = 'mem1_ssd1_v2_x4'  }
            withLabel: 'process_medium' { machineType = 'mem2_ssd1_v2_x8'  }
            withLabel: 'process_high'   { machineType = 'mem2_ssd1_v2_x16' }
        }
        docker.enabled = true
        params {
            // Default container registry; override when deploying
            container_registry = 'ghcr.io/trethewey/lymphix'
        }
    }
}

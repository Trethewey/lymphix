// =====================================================================
// BCR/TCR Clonality Pipeline — Nextflow config
// =====================================================================

manifest {
    name            = 'lymphix'
    author          = 'Dr C.S. Trethewey'
    description     = 'BCR/TCR clonality + V(D)J rearrangement detection (TRUST4 + IgBLAST)'
    version         = file("${projectDir}/VERSION").text.trim()
    license         = 'AGPL-3.0-or-later'
    nextflowVersion = '>=23.10.0'
    mainScript      = 'main.nf'
}

// ---------------------------------------------------------------------
// Pipeline parameters (override with --param on CLI or -params-file)
// ---------------------------------------------------------------------
params {
    // Inputs
    samplesheet     = null
    outdir          = 'results'

    // Reference
    species         = 'human'                  // human | mouse
    receptor        = 'all'                    // all | bcr | tcr
                                               // declared for the DNAnexus wrapper (src/code.sh);
                                               // no process in main.nf reads it yet
    panel_bed       = "${projectDir}/assets/regions/clonality_BCR_TCR.bed"
                                               // reference material for on-target QC —
                                               // no process reads it; see README "Panel BED"

    // Tool params
    // trust4_threads / igblast_threads are inert: the processes size themselves
    // from task.cpus via the process_* labels below. Left in place so existing
    // -params-file inputs do not break.
    trust4_threads  = 8
    igblast_threads = 4
    min_clone_count = 2                        // discard singleton CDR3s
    igh_mutated_cutoff = 98.0                  // %V-identity threshold for IGHV-unmutated

    // Clonotype collapsing. DEFAULT OFF, deliberately: TRUST4 emits one row per
    // (assembly, CDR3 variant), so collapsing changes n_clonotypes and with it
    // every diversity metric. Turning it on silently would change published
    // numbers with no way to tell which run produced what. The choice is
    // recorded in every metrics.json either way.
    collapse_clonotypes     = false
    collapse_key            = 'locus_junction_nt'   // or locus_junction_nt_hamming1
    collapse_minor_fraction = 0.02                  // abundance gate for the hamming1 key

    // UMI handling
    umi_preset           = 'none'              // none | twist | xgen_duplex | xgen_simplex | custom
    umi_read_structure   = null                // override for --umi_preset=custom (fgbio syntax)
    bwa_index            = null                // bwa index dir (required if any sample uses UMIs)

    // QC assertions
    negative_max_clonotypes = 0                // negative controls must yield ≤ this many clonotypes

    // BAM handling
    filter_dups_in_bam = false                 // pre-filter -F 1024 before TRUST4 -b
                                               // (set true for Sentieon --consensus / Picard MarkDuplicates BAMs
                                               //  that flag-but-retain duplicate reads)

    // Test profile data generation
    test_clonal_reads     = 20000
    test_polyclonal_reads = 50000
    test_seed             = 42

    // Resource defaults
    max_cpus        = 16
    max_memory      = '64.GB'
    max_time        = '24.h'

    // Misc
    publish_dir_mode = 'copy'
    help             = false
}

// ---------------------------------------------------------------------
// Process defaults
// ---------------------------------------------------------------------
process {
    cpus   = { check_max( 2  * task.attempt, 'cpus'   ) }
    memory = { check_max( 4.GB * task.attempt, 'memory' ) }
    time   = { check_max( 2.h * task.attempt, 'time'   ) }

    errorStrategy = { task.exitStatus in [137,140,143,247] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: 'process_low' {
        cpus   = { check_max( 2,      'cpus'   ) }
        memory = { check_max( 4.GB,   'memory' ) }
    }
    withLabel: 'process_medium' {
        cpus   = { check_max( 4,      'cpus'   ) }
        memory = { check_max( 16.GB,  'memory' ) }
    }
    withLabel: 'process_high' {
        cpus   = { check_max( 8,      'cpus'   ) }
        memory = { check_max( 32.GB,  'memory' ) }
    }
}

// ---------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------
profiles {
    docker {
        docker.enabled         = true
        docker.userEmulation   = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        conda.enabled          = false
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    test {
        params.samplesheet = "${projectDir}/assets/test/samplesheet_test.csv"
        params.outdir      = 'results_test'
        // The test profile generates synthetic FASTQs into assets/test/ on first run
        params.run_simulate_test_data = true
    }

    dnanexus {
        // DNAnexus uses native executor; resources scale via instance type.
        process.executor       = 'local'   // overridden by dx-nextflow
        docker.enabled         = true
        // Containers pulled from registry configured by DNAnexus project
    }
}

includeConfig 'conf/dnanexus.config'

// ---------------------------------------------------------------------
// Reporting
// ---------------------------------------------------------------------
report  { enabled = true; file = "${params.outdir}/pipeline_info/execution_report.html"; overwrite = true }
trace   { enabled = true; file = "${params.outdir}/pipeline_info/execution_trace.txt";   overwrite = true }
timeline{ enabled = true; file = "${params.outdir}/pipeline_info/execution_timeline.html"; overwrite = true }
dag     { enabled = true; file = "${params.outdir}/pipeline_info/pipeline_dag.html";      overwrite = true }

// ---------------------------------------------------------------------
// Helper: clamp resources to ceiling
// ---------------------------------------------------------------------
def check_max(obj, type) {
    if (type == 'memory') {
        try { return obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1 ? params.max_memory as nextflow.util.MemoryUnit : obj }
        catch (all) { return obj }
    } else if (type == 'time') {
        try { return obj.compareTo(params.max_time as nextflow.util.Duration) == 1 ? params.max_time as nextflow.util.Duration : obj }
        catch (all) { return obj }
    } else if (type == 'cpus') {
        try { return Math.min( obj as int, params.max_cpus as int ) }
        catch (all) { return obj }
    }
    return obj
}
